// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id                  String    @id
  shop                String
  shopRecord          Shop?     @relation(fields: [shop], references: [shopDomain], onDelete: Cascade)
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Shop {
  id              String         @id @default(uuid())
  shopDomain      String         @unique
  sessions        Session[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  googleAccountId String?
  googleAccount   GoogleAccount? @relation(fields: [googleAccountId], references: [id], onDelete: SetNull)
  sheetId         String?
  sheetUrl        String?
  lastSyncedAt    DateTime?
  isSyncing       Boolean        @default(false)
  activeSyncType  String?
  productCount    Int            @default(0)
  sheetHash       String?
  snapshotData    String?
  syncLogs        SyncLog[]
}

model GoogleAccount {
  id           String    @id @default(uuid())
  email        String?
  accessToken  String
  refreshToken String?
  scopes       String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  shops        Shop[]
}

model SyncLog {
  id        String   @id @default(uuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  type      String
  status    String
  details   String
  itemCount Int      @default(0)
  createdAt DateTime @default(now())
}

